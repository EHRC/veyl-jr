# Copia este archivo a .env y completa tu clave. El .env no se sube al repo.

# --- Clave (obligatoria) ---
# https://www.assemblyai.com : el audio se envía a AssemblyAI para transcribirlo.
ASSEMBLYAI_API_KEY=

# --- Transcripción ---
# universal-streaming-multilingual = más barato. universal-3-5-pro / universal-3-6-pro = más preciso y más caro.
STT_MODEL=universal-streaming-multilingual
# Términos que la transcripción debe reconocer bien (nombres, siglas), separados por coma
PALABRAS_CLAVE=

# --- Audio ---
# Parte del nombre del dispositivo que trae el audio de los demás (ver: python main.py --dispositivos)
DISPOSITIVO_OTROS=BlackHole
# Vacío = micrófono por defecto
DISPOSITIVO_MIC=
# true = también transcribe tu voz ("Yo"). false = solo a los demás (la mitad del costo de transcripción)
TRANSCRIBIR_MIC=true

# --- Dónde se guardan las reuniones ---
# Vacío = ~/Documents/Veyl Jr/Reuniones
CARPETA_REUNIONES=
